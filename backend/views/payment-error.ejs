<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title><%= error %> · SkyWings</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { min-height: 100vh; background: #F6F7FB; color: #151B2E; font: 400 15px/1.5 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    .top { background: #0B1630; }
    .top div { max-width: 960px; margin: 0 auto; height: 64px; padding: 0 24px; display: flex; align-items: center; }
    .logo { display: inline-flex; align-items: center; gap: 10px; color: #fff; font: 800 19px/1 'Plus Jakarta Sans', sans-serif; text-decoration: none; }
    .logo span { width: 30px; height: 30px; border-radius: 8px; background: #1F5EFF; display: grid; place-items: center; }
    .card { max-width: 520px; margin: 64px auto; padding: 40px 32px; background: #fff; border: 1px solid #E2E6EF; border-radius: 24px; text-align: center; box-shadow: 0 12px 32px -6px #0b163024; }
    .icon { width: 64px; height: 64px; margin: 0 auto 20px; border-radius: 50%; display: grid; place-items: center; background: #FDECEC; color: #B4262B; }
    h1 { font: 800 24px/1.25 'Plus Jakarta Sans', sans-serif; letter-spacing: -0.02em; }
    p { margin-top: 10px; color: #4E5872; }
    .ref { display: inline-block; margin-top: 16px; padding: 6px 12px; border-radius: 999px; background: #EEF0F6; font: 600 12px/1.4 'Inter', sans-serif; color: #4E5872; }
    .actions { display: flex; gap: 12px; justify-content: center; margin-top: 28px; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; height: 46px; padding: 0 22px; border-radius: 999px; font: 600 14px/1 'Inter', sans-serif; text-decoration: none; }
    .btn--primary { background: #1F5EFF; color: #fff; }
    .btn--secondary { border: 1px solid #CBD2DF; color: #151B2E; background: #fff; }
    @media (max-width: 560px) { .card { margin: 24px 16px; padding: 32px 20px; } .btn { flex: 1; justify-content: center; } }
  </style>
</head>
<body>
  <header class="top"><div>
    <a class="logo" href="<%= typeof frontendUrl !== 'undefined' ? frontendUrl : '/' %>">
      <span><svg width="17" height="17" viewBox="0 0 24 24" fill="#fff"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg></span>
      SkyWings
    </a>
  </div></header>

  <main class="card" role="alert">
    <div class="icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg></div>
    <h1><%= error %></h1>
    <p><%= message %></p>
    <% if (typeof paymentReference !== 'undefined' && paymentReference) { %><span class="ref">Payment reference <%= paymentReference %></span><% } %>
    <div class="actions">
      <a class="btn btn--primary" href="<%= typeof frontendUrl !== 'undefined' ? frontendUrl : '' %>/my-bookings">Go to My trips</a>
      <a class="btn btn--secondary" href="<%= typeof frontendUrl !== 'undefined' ? frontendUrl : '' %>/">New search</a>
    </div>
  </main>
</body>
</html>
