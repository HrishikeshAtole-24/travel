<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0B1630">
  <title>Secure payment · SkyWings</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <style>
    :root {
      --ink: #0B1630; --ink-raised: #13213F; --brand: #1F5EFF; --brand-hover: #1849D6; --brand-subtle: #EEF3FF;
      --accent: #FF6A3D; --accent-hover: #F04E1F; --canvas: #F6F7FB; --surface: #FFFFFF; --subtle: #EEF0F6;
      --text: #151B2E; --text2: #4E5872; --text3: #6B7590; --border: #E2E6EF; --border-strong: #CBD2DF;
      --success: #0B7A3B; --success-bg: #E9F8EF; --success-solid: #12A150; --warning: #B4740B; --warning-bg: #FFF7E6;
      --danger: #B4262B; --danger-bg: #FDECEC;
      --display: 'Plus Jakarta Sans', system-ui, sans-serif; --ui: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --shadow-3: 0 12px 32px -6px #0b163024, 0 4px 8px -2px #0b16300f;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { min-height: 100vh; background: var(--canvas); color: var(--text); font: 400 15px/1.5 var(--ui); -webkit-font-smoothing: antialiased; }
    a { color: var(--brand); text-decoration: none; }
    svg { display: block; }

    /* Top bar */
    .topbar { background: var(--ink); color: #fff; }
    .topbar__in { max-width: 1040px; margin: 0 auto; height: 64px; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .logo { display: inline-flex; align-items: center; gap: 10px; color: #fff; font: 800 19px/1 var(--display); letter-spacing: -0.02em; }
    .logo__mark { width: 30px; height: 30px; border-radius: 8px; background: var(--brand); display: grid; place-items: center; }
    .steps { display: flex; align-items: center; gap: 10px; list-style: none; font: 500 13px/1 var(--ui); color: #98A2B8; }
    .steps li { display: flex; align-items: center; gap: 8px; }
    .steps li + li::before { content: ''; width: 28px; height: 1.5px; background: #384159; margin-right: 2px; }
    .steps .dot { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid #4E5872; font: 700 11px/1 var(--display); }
    .steps .done .dot { background: var(--success-solid); border-color: var(--success-solid); color: #fff; }
    .steps .done { color: #E2E6EF; }
    .steps .cur { color: #fff; font-weight: 600; }
    .steps .cur .dot { background: var(--brand); border-color: var(--brand); color: #fff; }
    .secure { display: inline-flex; align-items: center; gap: 6px; font: 600 13px/1 var(--ui); color: #6FDB9C; }

    /* Layout */
    .wrap { max-width: 1040px; margin: 0 auto; padding: 32px 24px 64px; display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 32px; align-items: start; }
    .back { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 14px; font: 600 14px/1 var(--ui); color: var(--brand); background: none; border: 0; cursor: pointer; }
    h1 { font: 700 30px/1.2 var(--display); letter-spacing: -0.02em; }
    .sub { margin-top: 4px; color: var(--text2); }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; }
    .overline { font: 600 11px/1.45 var(--ui); letter-spacing: .08em; text-transform: uppercase; color: var(--text3); }

    /* Order summary */
    .summary { margin-top: 24px; overflow: hidden; }
    .summary__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 20px; background: var(--brand-subtle); }
    .summary__ref { font: 800 17px/1.2 var(--display); letter-spacing: .01em; margin-top: 2px; }
    .chip { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border-radius: 999px; font: 600 12px/1 var(--ui); }
    .chip--warn { background: var(--warning-bg); color: var(--warning); }
    .leg { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; padding: 20px; border-top: 1px solid var(--border); }
    .leg__code { font: 800 28px/1 var(--display); letter-spacing: -0.02em; color: var(--ink); }
    .leg__time { font: 700 15px/1.3 var(--display); margin-top: 6px; }
    .leg__date { font: 500 12px/1.4 var(--ui); color: var(--text2); }
    .leg__mid { text-align: center; font: 500 12px/1.4 var(--ui); color: var(--text2); }
    .leg__line { position: relative; height: 2px; margin: 8px 0; background: repeating-linear-gradient(90deg, var(--border-strong) 0 4px, transparent 4px 7px); }
    .leg__line svg { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) rotate(45deg); background: var(--surface); padding: 0 2px; color: var(--brand); }
    .leg__stops { font: 600 12px/1 var(--ui); color: var(--success); }
    .leg__stops.has { color: var(--warning); }
    .right { text-align: right; }
    .facts { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 14px 20px; border-top: 1px solid var(--border); font: 500 13px/1.4 var(--ui); color: var(--text2); }
    .facts strong { color: var(--text); font-weight: 600; }
    .hotel { display: flex; gap: 16px; padding: 20px; border-top: 1px solid var(--border); }
    .hotel img { width: 132px; height: 100px; object-fit: cover; border-radius: 12px; flex-shrink: 0; }
    .hotel h3 { font: 700 18px/1.3 var(--display); }
    .hotel p { font: 400 13px/1.5 var(--ui); color: var(--text2); }
    .stay { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--border); }
    .stay div { padding: 14px 20px; }
    .stay div + div { border-left: 1px solid var(--border); }
    .stay strong { display: block; font: 600 15px/1.3 var(--ui); margin-top: 2px; }
    .contact { margin-top: 16px; padding: 14px 20px; display: flex; align-items: center; gap: 12px; font: 400 13px/1.5 var(--ui); color: var(--text2); }
    .contact svg { color: var(--brand); flex-shrink: 0; }

    /* Pay card */
    .pay { position: sticky; top: 24px; padding: 24px; box-shadow: var(--shadow-3); border-radius: 24px; }
    .pay__label { font: 500 13px/1 var(--ui); color: var(--text2); }
    .pay__amount { font: 800 34px/1.1 var(--display); letter-spacing: -0.02em; margin: 6px 0 2px; }
    .pay__amount small { font: 600 16px/1 var(--display); color: var(--text2); margin-right: 4px; }
    .pay__note { font: 500 12px/1.4 var(--ui); color: var(--text3); }
    .hold { display: flex; align-items: center; gap: 8px; margin: 18px 0; padding: 10px 14px; border-radius: 12px; background: var(--warning-bg); color: var(--warning); font: 600 13px/1.3 var(--ui); }
    .hold.is-expired { background: var(--danger-bg); color: var(--danger); }
    .hold b { font-variant-numeric: tabular-nums; }
    .btn { display: flex; width: 100%; align-items: center; justify-content: center; gap: 8px; height: 54px; border: 0; border-radius: 999px; font: 700 16px/1 var(--display); cursor: pointer; transition: background-color .15s, transform .15s; }
    .btn:active:not(:disabled) { transform: scale(.98); }
    .btn--pay { background: var(--accent); color: #fff; box-shadow: 0 8px 20px -8px rgba(255,106,61,.6); }
    .btn--pay:hover:not(:disabled) { background: var(--accent-hover); }
    .btn:disabled { background: var(--subtle); color: #98A2B8; box-shadow: none; cursor: not-allowed; }
    .btn--ghost { height: 44px; margin-top: 8px; background: transparent; color: var(--text2); font: 600 14px/1 var(--ui); }
    .btn--ghost:hover { background: var(--subtle); }
    .methods { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin: 18px 0 12px; }
    .methods span { padding: 5px 10px; border: 1px solid var(--border); border-radius: 8px; font: 600 11px/1 var(--ui); color: var(--text2); }
    .trust { display: flex; gap: 8px; align-items: flex-start; padding-top: 14px; border-top: 1px solid var(--border); font: 400 12px/1.5 var(--ui); color: var(--text3); }
    .trust svg { color: var(--success-solid); flex-shrink: 0; margin-top: 1px; }

    /* Processing */
    .progress { display: none; }
    .is-processing .pay__actions { display: none; }
    .is-processing .progress { display: block; }
    .progress h3 { font: 700 18px/1.3 var(--display); margin-bottom: 4px; }
    .progress > p { font: 400 13px/1.5 var(--ui); color: var(--text2); margin-bottom: 16px; }
    .pstep { display: flex; align-items: center; gap: 12px; padding: 10px 0; font: 500 14px/1.3 var(--ui); color: var(--text3); }
    .pstep i { width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--border-strong); display: grid; place-items: center; flex-shrink: 0; }
    .pstep.on { color: var(--text); font-weight: 600; }
    .pstep.on i { border: 2.5px solid var(--brand-subtle); border-top-color: var(--brand); animation: spin .8s linear infinite; }
    .pstep.ok { color: var(--text); }
    .pstep.ok i { background: var(--success-solid); border-color: var(--success-solid); color: #fff; }
    .bar { height: 4px; border-radius: 999px; background: var(--brand-subtle); overflow: hidden; margin-top: 14px; }
    .bar span { display: block; height: 100%; width: 35%; border-radius: 999px; background: var(--brand); animation: slide 1.2s ease-in-out infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes slide { from { transform: translateX(-100%); } to { transform: translateX(300%); } }

    footer { max-width: 1040px; margin: 0 auto; padding: 0 24px 32px; display: flex; justify-content: space-between; gap: 12px; font: 400 12px/1.5 var(--ui); color: var(--text3); }
    footer a { color: var(--text3); margin-left: 14px; }

    @media (max-width: 900px) {
      .wrap { grid-template-columns: 1fr; padding-top: 20px; }
      .pay { position: static; }
      .steps li:not(.cur) span.label { display: none; }
    }
    @media (max-width: 560px) {
      .steps { display: none; }
      h1 { font-size: 24px; }
      .leg { padding: 16px; gap: 10px; }
      .leg__code { font-size: 24px; }
      .hotel img { width: 96px; height: 80px; }
      footer { flex-direction: column; }
      footer a { margin: 0 14px 0 0; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar__in">
      <a class="logo" href="<%= frontendUrl %>">
        <span class="logo__mark"><svg width="17" height="17" viewBox="0 0 24 24" fill="#fff"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg></span>
        SkyWings
      </a>
      <ol class="steps" aria-label="Booking progress">
        <li class="done"><span class="dot">&#10003;</span><span class="label"><%= summary.type === 'hotel' ? 'Room' : 'Flight' %></span></li>
        <li class="done"><span class="dot">&#10003;</span><span class="label"><%= summary.type === 'hotel' ? 'Guests' : 'Travellers' %></span></li>
        <li class="cur" aria-current="step"><span class="dot">3</span><span class="label">Payment</span></li>
        <li><span class="dot">4</span><span class="label">Confirmed</span></li>
      </ol>
      <span class="secure">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
        Secure checkout
      </span>
    </div>
  </header>

  <main class="wrap" id="app">
    <section>
      <button class="back" type="button" onclick="goBack()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back
      </button>
      <h1>Review and pay</h1>
      <p class="sub">Check the details below, then pay securely to confirm your <%= summary.type === 'hotel' ? 'stay' : 'flight' %>.</p>

      <div class="card summary">
        <div class="summary__head">
          <div>
            <div class="overline" style="color: var(--brand)">Booking reference</div>
            <div class="summary__ref"><%= bookingReference %></div>
          </div>
          <% if (deadline) { %><span class="chip chip--warn">Awaiting payment</span><% } %>
        </div>

        <% if (summary.type === 'hotel') { %>
          <div class="hotel">
            <% if (summary.photo) { %><img src="<%= summary.photo %>" alt=""><% } %>
            <div>
              <h3><%= summary.title %></h3>
              <% if (summary.address) { %><p><%= summary.address %></p><% } %>
              <% if (summary.room) { %><p style="color: var(--text); font-weight: 600; margin-top: 4px;"><%= summary.room %></p><% } %>
            </div>
          </div>
          <div class="stay">
            <div><span class="overline">Check-in</span><strong data-date="<%= summary.checkIn %>"><%= summary.checkIn %></strong></div>
            <div><span class="overline">Check-out</span><strong data-date="<%= summary.checkOut %>"><%= summary.checkOut %></strong></div>
          </div>
          <div class="facts">
            <% if (summary.nights) { %><span><strong><%= summary.nights %> night<%= summary.nights > 1 ? 's' : '' %></strong></span><% } %>
            <span><%= summary.guests %></span>
          </div>
        <% } else { %>
          <% summary.slices.forEach(function (s, i) { %>
            <div class="leg">
              <div>
                <div class="overline"><%= i === 0 ? 'Depart' : 'Return' %></div>
                <div class="leg__code"><%= s.from %></div>
                <div class="leg__time" data-time="<%= s.depart %>"></div>
                <div class="leg__date" data-date="<%= s.depart %>"></div>
              </div>
              <div class="leg__mid">
                <div data-duration="<%= s.durationMinutes || '' %>"></div>
                <div class="leg__line"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg></div>
                <div class="leg__stops <%= s.stops > 0 ? 'has' : '' %>"><%= s.stops === 0 ? 'Non-stop' : s.stops + ' stop' + (s.stops > 1 ? 's' : '') %></div>
              </div>
              <div class="right">
                <div class="overline">Arrive</div>
                <div class="leg__code"><%= s.to %></div>
                <div class="leg__time" data-time="<%= s.arrive %>"></div>
                <div class="leg__date" data-date="<%= s.arrive %>"></div>
              </div>
            </div>
            <div class="facts">
              <span><strong><%= s.airline %></strong> · <%= s.flightNumber %></span>
              <% if (summary.cabin) { %><span><%= summary.cabin %></span><% } %>
              <% if (summary.travellers) { %><span><%= summary.travellers %> traveller<%= summary.travellers > 1 ? 's' : '' %></span><% } %>
            </div>
          <% }) %>
          <% if (!summary.slices.length) { %><div class="facts"><span>Flight booking <strong><%= bookingReference %></strong></span></div><% } %>
        <% } %>
      </div>

      <% if (customerEmail) { %>
        <div class="card contact">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>Your <%= summary.type === 'hotel' ? 'voucher' : 'e-ticket' %> will be sent to <strong style="color: var(--text)"><%= customerEmail %></strong></span>
        </div>
      <% } %>
    </section>

    <aside class="card pay" id="payCard">
      <div class="pay__label">Total to pay</div>
      <div class="pay__amount"><small><%= currency === 'INR' ? '₹' : currency %></small><span id="amount"></span></div>
      <div class="pay__note">Includes all taxes and fees</div>

      <div class="pay__actions">
        <% if (deadline) { %>
          <div class="hold" id="hold">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <span id="holdText">Price held for <b id="countdown">--:--</b></span>
          </div>
        <% } else { %><div style="height: 18px"></div><% } %>
        <button class="btn btn--pay" id="payBtn" type="button" onclick="startPayment()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span id="payLabel">Pay now</span>
        </button>
        <button class="btn btn--ghost" type="button" onclick="goBack()">Cancel and go back</button>
        <div class="methods" aria-label="Payment methods"><span>UPI</span><span>Cards</span><span>Net banking</span><span>Wallets</span></div>
        <div class="trust">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Payments are processed by Razorpay over an encrypted connection. SkyWings never sees or stores your card details.</span>
        </div>
      </div>

      <div class="progress" role="status" aria-live="polite">
        <h3 id="progressTitle">Confirming your booking</h3>
        <p>This can take up to a minute. Please keep this window open.</p>
        <div class="pstep ok" id="s1"><i>&#10003;</i>Payment received</div>
        <div class="pstep on" id="s2"><i></i><%= summary.type === 'hotel' ? 'Confirming your room with the hotel' : 'Confirming seats with the airline' %></div>
        <div class="pstep" id="s3"><i></i><%= summary.type === 'hotel' ? 'Preparing your voucher' : 'Issuing your e-ticket' %></div>
        <div class="bar"><span></span></div>
      </div>
    </aside>
  </main>

  <footer>
    <span>© <%= new Date().getFullYear() %> SkyWings Travel · Prices in <%= currency %></span>
    <span>
      <a href="<%= frontendUrl %>/terms-and-conditions">Terms</a>
      <a href="<%= frontendUrl %>/privacy-policy">Privacy</a>
      <a href="<%= frontendUrl %>/refund-policy">Refunds</a>
      <a href="<%= frontendUrl %>/contact">Help</a>
    </span>
  </footer>

  <script>
    const PAY = <%- JSON.stringify(checkout).replace(/</g, '\\u003c') %>;
    const AMOUNT = <%- JSON.stringify(amount) %>;
    const DEADLINE = <%- JSON.stringify(deadline) %>;

    // Local wall-clock formatting (times are already airport-local)
    const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    document.getElementById('amount').textContent = Number(AMOUNT).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    document.getElementById('payLabel').textContent = 'Pay ' + (PAY.currency === 'INR' ? '₹' : PAY.currency + ' ') + Number(AMOUNT).toLocaleString('en-IN', { maximumFractionDigits: 2 });
    document.querySelectorAll('[data-time]').forEach(el => { const m = (el.dataset.time || '').match(/T(\d{2}:\d{2})/) || (el.dataset.time || '').match(/^(\d{2}:\d{2})/); el.textContent = m ? m[1] : ''; });
    document.querySelectorAll('[data-date]').forEach(el => { const m = (el.dataset.date || '').match(/^(\d{4})-(\d{2})-(\d{2})/); if (!m) { if (!el.dataset.time) el.textContent = ''; return; } const d = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])); el.textContent = DAYS[d.getUTCDay()] + ', ' + (+m[3]) + ' ' + MONTHS[+m[2] - 1] + ' ' + m[1]; });
    document.querySelectorAll('[data-duration]').forEach(el => { const n = +el.dataset.duration; el.textContent = n ? Math.floor(n / 60) + 'h ' + String(n % 60).padStart(2, '0') + 'm' : ''; });

    // Hold countdown — disables payment once the held fare/room expires
    let expired = false;
    if (DEADLINE) {
      const end = new Date(DEADLINE).getTime();
      const tick = () => {
        const left = Math.max(0, Math.floor((end - Date.now()) / 1000));
        const h = Math.floor(left / 3600), m = Math.floor((left % 3600) / 60), s = left % 60;
        document.getElementById('countdown').textContent = (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(s).padStart(2, '0');
        if (left === 0 && !expired) {
          expired = true;
          document.getElementById('hold').classList.add('is-expired');
          document.getElementById('holdText').textContent = 'This price hold has expired. Please search again.';
          document.getElementById('payBtn').disabled = true;
        }
      };
      tick(); setInterval(tick, 1000);
    }

    function goBack() {
      if (history.length > 1) history.back(); else location.href = <%- JSON.stringify(frontendUrl) %>;
    }

    function withParams(base, params) {
      const u = new URL(base);
      Object.entries(params).forEach(([k, v]) => v && u.searchParams.set(k, v));
      return u.toString();
    }

    function showProgress() {
      document.getElementById('payCard').classList.add('is-processing');
      // Supplier confirmation runs on the server; advance the visible step while we wait
      setTimeout(() => { document.getElementById('s2').className = 'pstep ok'; document.getElementById('s2').querySelector('i').innerHTML = '&#10003;'; document.getElementById('s3').className = 'pstep on'; }, 7000);
    }

    function startPayment() {
      if (expired) return;
      const rzp = new Razorpay({
        key: PAY.key,
        amount: PAY.amount,
        currency: PAY.currency,
        name: 'SkyWings',
        description: PAY.description,
        order_id: PAY.orderId,
        prefill: PAY.prefill,
        theme: { color: '#1F5EFF' },
        handler: function (response) {
          showProgress();
          fetch('/api/payments/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_order_id: response.razorpay_order_id,
              razorpay_signature: response.razorpay_signature,
              bookingReference: PAY.bookingReference
            })
          })
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                location.href = withParams(PAY.successUrl, { booking: PAY.bookingReference, payment: response.razorpay_payment_id });
              } else {
                location.href = withParams(PAY.failureUrl, { booking: PAY.bookingReference, reason: data.message || 'We could not verify this payment.' });
              }
            })
            .catch(() => {
              location.href = withParams(PAY.failureUrl, { booking: PAY.bookingReference, reason: 'Connection lost while confirming. If you were charged, your booking will update in My trips shortly.' });
            });
        }
      });
      rzp.on('payment.failed', function (response) {
        location.href = withParams(PAY.failureUrl, { booking: PAY.bookingReference, reason: response.error && response.error.description });
      });
      rzp.open();
    }
  </script>
</body>
</html>
