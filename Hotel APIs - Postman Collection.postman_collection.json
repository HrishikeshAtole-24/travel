{
  "info": {
    "name": "SkyWings - Hotel APIs Collection",
    "_postman_id": "hotel-apis-collection",
    "description": "Complete Hotel APIs for SkyWings Travel Platform.\n\nIncludes:\n1. Hotel List Search (by city, geocode)\n2. Hotel Name Autocomplete\n3. Hotel Ratings/Sentiments\n4. Hotel Offers (Availability & Pricing)\n5. Hotel Offer Price Validation\n6. Hotel Booking (Create, Get, Cancel)\n7. Hotel Booking + Payment Flow\n\nBase URL: {{baseUrl}} (default: http://localhost:5000/api)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "hotelId",
      "value": "",
      "type": "string"
    },
    {
      "key": "offerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingReference",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Authentication endpoints for getting auth token",
      "item": [
        {
          "name": "Login (Get Auth Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.token) {",
                  "        pm.collectionVariables.set('authToken', response.data.token);",
                  "        console.log('Auth token saved!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "🏨 1. Hotel List Search",
      "description": "Search hotels by city code or geocode. Returns list of available hotels.",
      "item": [
        {
          "name": "Search Hotels by City",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.length > 0) {",
                  "        pm.collectionVariables.set('hotelId', response.data[0].hotelId);",
                  "        console.log('First hotelId saved: ' + response.data[0].hotelId);",
                  "    }",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "    pm.test('Has data array', () => pm.expect(response.data).to.be.an('array'));",
                  "    pm.test('Has meta', () => pm.expect(response.meta).to.exist);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/search/city?cityCode=PAR&ratings=4,5&radius=10&radiusUnit=KM&hotelSource=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "search", "city"],
              "query": [
                { "key": "cityCode", "value": "PAR", "description": "IATA city code (required)" },
                { "key": "ratings", "value": "4,5", "description": "Star ratings filter (1-5)" },
                { "key": "radius", "value": "10", "description": "Search radius" },
                { "key": "radiusUnit", "value": "KM", "description": "KM or MILE" },
                { "key": "hotelSource", "value": "ALL", "description": "ALL, BEDBANK, DIRECTCHAIN" },
                { "key": "amenities", "value": "", "description": "SWIMMING_POOL,WIFI,etc", "disabled": true },
                { "key": "chainCodes", "value": "", "description": "Hotel chain codes (HL, HY, MC)", "disabled": true },
                { "key": "page", "value": "1", "description": "Page number", "disabled": true },
                { "key": "pageSize", "value": "20", "description": "Results per page", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Search Hotels by City - Mumbai",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/search/city?cityCode=BOM&ratings=3,4,5",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "search", "city"],
              "query": [
                { "key": "cityCode", "value": "BOM" },
                { "key": "ratings", "value": "3,4,5" }
              ]
            }
          }
        },
        {
          "name": "Search Hotels by City - London",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/search/city?cityCode=LON&ratings=4,5&radius=5",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "search", "city"],
              "query": [
                { "key": "cityCode", "value": "LON" },
                { "key": "ratings", "value": "4,5" },
                { "key": "radius", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Search Hotels by Geocode",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/search/geocode?latitude=48.8566&longitude=2.3522&radius=5&radiusUnit=KM",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "search", "geocode"],
              "query": [
                { "key": "latitude", "value": "48.8566", "description": "Latitude (required)" },
                { "key": "longitude", "value": "2.3522", "description": "Longitude (required)" },
                { "key": "radius", "value": "5", "description": "Search radius" },
                { "key": "radiusUnit", "value": "KM", "description": "KM or MILE" },
                { "key": "ratings", "value": "", "description": "Star ratings", "disabled": true },
                { "key": "amenities", "value": "", "description": "Amenities filter", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Search Hotels by Geocode - Mumbai",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/search/geocode?latitude=19.0760&longitude=72.8777&radius=10&radiusUnit=KM",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "search", "geocode"],
              "query": [
                { "key": "latitude", "value": "19.0760" },
                { "key": "longitude", "value": "72.8777" },
                { "key": "radius", "value": "10" },
                { "key": "radiusUnit", "value": "KM" }
              ]
            }
          }
        }
      ]
    },
    {
