    {
      "name": "⭐ 3. Hotel Ratings",
      "description": "Get hotel ratings and guest sentiments",
      "item": [
        {
          "name": "Get Hotel Ratings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/ratings?hotelIds={{hotelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "ratings"],
              "query": [
                { "key": "hotelIds", "value": "{{hotelId}}", "description": "Comma-separated hotel IDs (max 3)" }
              ]
            }
          }
        },
        {
          "name": "Get Hotel Ratings - Multiple",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/ratings?hotelIds=MCLONGHM,HILONDON",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "ratings"],
              "query": [
                { "key": "hotelIds", "value": "MCLONGHM,HILONDON" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "💰 4. Hotel Offers (Pricing)",
      "description": "Get real-time hotel offers with pricing and availability",
      "item": [
        {
          "name": "Search Hotel Offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.length > 0) {",
                  "        const firstOffer = response.data[0];",
                  "        pm.collectionVariables.set('offerId', firstOffer.source.supplierOfferId);",
                  "        console.log('First offerId saved: ' + firstOffer.source.supplierOfferId);",
                  "    }",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "    pm.test('Has offers', () => pm.expect(response.data).to.be.an('array'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/offers?hotelIds={{hotelId}}&adults=2&checkInDate=2025-09-01&checkOutDate=2025-09-03&roomQuantity=1",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "offers"],
              "query": [
                { "key": "hotelIds", "value": "{{hotelId}}", "description": "Hotel IDs (required)" },
                { "key": "adults", "value": "2", "description": "Number of adults" },
                { "key": "checkInDate", "value": "2025-09-01", "description": "Check-in date (YYYY-MM-DD)" },
                { "key": "checkOutDate", "value": "2025-09-03", "description": "Check-out date (YYYY-MM-DD)" },
                { "key": "roomQuantity", "value": "1", "description": "Number of rooms (1-9)" },
                { "key": "currency", "value": "", "description": "Currency code (EUR, USD, INR)", "disabled": true },
                { "key": "priceRange", "value": "", "description": "Price range (e.g., 100-300)", "disabled": true },
                { "key": "boardType", "value": "", "description": "ROOM_ONLY, BREAKFAST, etc", "disabled": true },
                { "key": "paymentPolicy", "value": "", "description": "NONE, GUARANTEE, DEPOSIT", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Search Hotel Offers - With Currency",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/offers?hotelIds={{hotelId}}&adults=1&checkInDate=2025-09-15&checkOutDate=2025-09-17&currency=INR",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "offers"],
              "query": [
                { "key": "hotelIds", "value": "{{hotelId}}" },
                { "key": "adults", "value": "1" },
                { "key": "checkInDate", "value": "2025-09-15" },
                { "key": "checkOutDate", "value": "2025-09-17" },
                { "key": "currency", "value": "INR" }
              ]
            }
          }
        },
        {
          "name": "Validate Hotel Offer (Get by ID)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "offers", "{{offerId}}"]
            },
            "description": "Validate and get latest price for a specific hotel offer. Use an offer ID from the hotel search results."
          }
        }
      ]
    },
    {
      "name": "🎫 5. Hotel Booking",
      "description": "Create and manage hotel bookings",
      "item": [
        {
          "name": "Create Hotel Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data) {",
                  "        pm.collectionVariables.set('bookingReference', response.data.bookingReference);",
                  "        pm.collectionVariables.set('bookingId', response.data.bookingId.toString());",
                  "        console.log('Booking reference saved: ' + response.data.bookingReference);",
                  "        console.log('Booking ID saved: ' + response.data.bookingId);",
                  "    }",
                  "    pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "    pm.test('Has bookingReference', () => pm.expect(response.data.bookingReference).to.exist);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}", "description": "Optional - for registered users" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"offerId\": \"{{offerId}}\",\n  \"hotelName\": \"Test Hotel\",\n  \"hotelData\": {\n    \"hotelId\": \"{{hotelId}}\",\n    \"name\": \"Test Hotel\",\n    \"chainCode\": \"MC\"\n  },\n  \"offerData\": {\n    \"offerId\": \"{{offerId}}\",\n    \"room\": { \"type\": \"STANDARD\" }\n  },\n  \"checkInDate\": \"2025-09-01\",\n  \"checkOutDate\": \"2025-09-03\",\n  \"roomQuantity\": 1,\n  \"adults\": 2,\n  \"guests\": [\n    {\n      \"title\": \"MR\",\n      \"firstName\": \"John\",\n      \"lastName\": \"Doe\",\n      \"email\": \"john.doe@example.com\",\n      \"phone\": \"+919876543210\"\n    },\n    {\n      \"title\": \"MS\",\n      \"firstName\": \"Jane\",\n      \"lastName\": \"Doe\",\n      \"email\": \"jane.doe@example.com\"\n    }\n  ],\n  \"contactEmail\": \"john.doe@example.com\",\n  \"contactPhone\": \"+919876543210\",\n  \"totalPrice\": 250.00,\n  \"currency\": \"USD\",\n  \"specialRequests\": \"Early check-in if possible\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings/create",
              "host": ["{{baseUrl}}"],
              "path": ["hotel-bookings", "create"]
            }
          }
        },
        {
          "name": "Create Hotel Booking + Pay (Combined)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.booking) {",
                  "        pm.collectionVariables.set('bookingReference', response.data.booking.bookingReference);",
                  "        pm.collectionVariables.set('bookingId', response.data.booking.bookingId.toString());",
                  "        console.log('Booking + Payment created!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}", "description": "Optional" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"offerId\": \"{{offerId}}\",\n  \"hotelName\": \"Test Hotel\",\n  \"hotelData\": {\n    \"hotelId\": \"{{hotelId}}\",\n    \"name\": \"Test Hotel\"\n  },\n  \"offerData\": {\n    \"offerId\": \"{{offerId}}\"\n  },\n  \"checkInDate\": \"2025-09-01\",\n  \"checkOutDate\": \"2025-09-03\",\n  \"roomQuantity\": 1,\n  \"adults\": 2,\n  \"guests\": [\n    {\n      \"title\": \"MR\",\n      \"firstName\": \"John\",\n      \"lastName\": \"Doe\",\n      \"email\": \"john.doe@example.com\",\n      \"phone\": \"+919876543210\"\n    }\n  ],\n  \"contactEmail\": \"john.doe@example.com\",\n  \"contactPhone\": \"+919876543210\",\n  \"totalPrice\": 250.00,\n  \"currency\": \"USD\",\n  \"specialRequests\": \"Non-smoking room\",\n  \"paymentAcquirer\": \"RAZORPAY\",\n  \"successUrl\": \"http://localhost:3000/booking/success\",\n  \"failureUrl\": \"http://localhost:3000/booking/failure\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings/create-and-pay",
              "host": ["{{baseUrl}}"],
              "path": ["hotel-bookings", "create-and-pay"]
            }
          }
        },
        {
          "name": "Get Hotel Booking by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotel-bookings", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Get Hotel Booking by Reference",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings/reference/{{bookingReference}}?email=john.doe@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["hotel-bookings", "reference", "{{bookingReference}}"],
              "query": [
                { "key": "email", "value": "john.doe@example.com", "description": "Email for guest verification" }
              ]
            }
          }
        },
        {
          "name": "Get My Hotel Bookings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings/my-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["hotel-bookings", "my-bookings"]
            }
          }
        },
        {
          "name": "Confirm Hotel Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentDetails\": {\n    \"providerConfirmationId\": \"CONF123456\",\n    \"amadeusOrderId\": \"ORD789012\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings/{{bookingId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["hotel-bookings", "{{bookingId}}", "confirm"]
            }
          }
        },
        {
          "name": "Cancel Hotel Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Plans changed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hotel-bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["hotel-bookings", "{{bookingId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "🧪 Complete Flow Test",
      "description": "End-to-end flow: Search City → Get Hotels → Get Offers → Validate Offer → Book → Pay",
      "item": [
        {
          "name": "Step 1: Search Hotels in Paris",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.length > 0) {",
                  "        pm.collectionVariables.set('hotelId', response.data[0].hotelId);",
                  "        console.log('Hotel ID for next step: ' + response.data[0].hotelId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/search/city?cityCode=PAR&ratings=4,5",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "search", "city"],
              "query": [
                { "key": "cityCode", "value": "PAR" },
                { "key": "ratings", "value": "4,5" }
              ]
            }
          }
        },
        {
          "name": "Step 2: Get Hotel Offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.length > 0) {",
                  "        const offer = response.data[0];",
                  "        pm.collectionVariables.set('offerId', offer.source.supplierOfferId);",
                  "        console.log('Offer ID for next step: ' + offer.source.supplierOfferId);",
                  "        console.log('Price: ' + offer.pricing.totalCurrency + ' ' + offer.pricing.totalAmount);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/offers?hotelIds={{hotelId}}&adults=2&checkInDate=2025-09-01&checkOutDate=2025-09-03",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "offers"],
              "query": [
                { "key": "hotelIds", "value": "{{hotelId}}" },
                { "key": "adults", "value": "2" },
                { "key": "checkInDate", "value": "2025-09-01" },
                { "key": "checkOutDate", "value": "2025-09-03" }
              ]
            }
          }
        },
        {
          "name": "Step 3: Validate Offer Price",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/hotels/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["hotels", "offers", "{{offerId}}"]
            }
          }
        },
        {
          "name": "Step 4: Create Booking + Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.booking) {",
                  "        pm.collectionVariables.set('bookingReference', response.data.booking.bookingReference);",
                  "        pm.collectionVariables.set('bookingId', response.data.booking.bookingId.toString());",
                  "        console.log('Booking created: ' + response.data.booking.bookingReference);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
